# Names only. Never put secrets in this file.

# 32-byte Ed25519 secret as hex, or generate with: npm run keygen -- --out ./secrets/bot.key
JEB_SLIM_SECRET_KEY_HEX=

# Optional: signup when the account does not exist yet
JEB_SLIM_HOMESERVER=
JEB_SLIM_SIGNUP_TOKEN=

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

JEB_SLIM_NEXUS_URL=https://nexus.staging.pubky.app
JEB_SLIM_POLL_MS=10000
JEB_SLIM_MAX_AGE_MINUTES=30
JEB_SLIM_MAX_REPLIES_PER_THREAD=1
JEB_SLIM_MAX_PER_USER_PER_HOUR=5
JEB_SLIM_BLOCKLIST=
JEB_SLIM_DISABLED=0
JEB_SLIM_PORT=8787

JEB_SLIM_MODEL=gpt-4o-mini
JEB_SLIM_MODEL_BASE_URL=
JEB_SLIM_MODEL_API_KEY=
JEB_SLIM_MODEL_TIMEOUT_MS=30000
JEB_SLIM_CANNED_REPLY=
